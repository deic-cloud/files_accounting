<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>files_accounting</id>
	<name>Storage Accounting</name>
	<description>Track storage usage, generate invoices, and expose a billing API for institutional customers.</description>
	<version>1.0.0</version>
	<licence>AGPL</licence>
	<author>ScienceData</author>
	<namespace>FilesAccounting</namespace>
	<category>files</category>
	<types>
		<type>filesystem</type>
	</types>
	<dependencies>
		<nextcloud min-version="34" max-version="35"/>
	</dependencies>
	<background-jobs>
		<job>OCA\FilesAccounting\BackgroundJob\Stats</job>
	</background-jobs>
	<settings>
		<admin>OCA\FilesAccounting\Settings\AdminSettings</admin>
		<admin-section>OCA\FilesAccounting\Settings\AdminSection</admin-section>
		<personal>OCA\FilesAccounting\Settings\PersonalSettings</personal>
		<personal-section>OCA\FilesAccounting\Settings\PersonalSection</personal-section>
	</settings>
</info>
